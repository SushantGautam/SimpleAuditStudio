# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Bootstrap
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=change-me
BOOTSTRAP_PROJECT_NAME=Default

# PostgreSQL
POSTGRES_DB=simpleaudit
POSTGRES_USER=simpleaudit
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://simpleaudit:change-me@postgres:5432/simpleaudit

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=simpleaudit-artifacts

# Durable workflow system (Hatchet)
HATCHET_SERVER_URL=http://hatchet-server:8000
HATCHET_GRPC_URL=hatchet-server:8001
HATCHET_API_KEY=
HATCHET_TOKEN_FILE=/config/authdisabled-token
HATCHET_TLS_STRATEGY=none
WORKER_POOL=cpu

# Operational limits
MAX_CONCURRENT_AUDITS=2
MAX_SCENARIOS_PER_RUN=500
SSE_MAX_CONNECTIONS_PER_USER=10

# SimpleAudit engine provenance (pinned)
SIMPLEAUDIT_VERSION=0.1.9
SIMPLEAUDIT_GIT_COMMIT=bc32a753e28b7e3b9fb09ac4479292f1c275a03b
SIMPLEAUDIT_ENGINE_PATH=/opt/simpleaudit

# Optional observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Sentry error tracking & tracing (leave empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
