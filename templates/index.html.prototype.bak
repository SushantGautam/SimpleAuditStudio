<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>SimpleAudit Platform</title>
<style>
  :root{
    --bg:#0b0e14; --panel:#121722; --panel2:#161d2b; --border:#232c3d;
    --text:#e6ebf5; --muted:#8a97ad; --accent:#4f8cff; --accent2:#7c5cff;
    --ok:#2ecc71; --warn:#f5a623; --bad:#ff5c5c; --chip:#1c2536;
  }
  *{box-sizing:border-box}
  body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;background:var(--bg);color:var(--text);}
  a{color:var(--accent);text-decoration:none}
  header{display:flex;align-items:center;gap:16px;padding:16px 24px;border-bottom:1px solid var(--border);background:linear-gradient(90deg,#0e1420,#0b0e14);}
  header h1{font-size:18px;margin:0;font-weight:600;letter-spacing:.3px}
  header .logo{width:28px;height:28px;border-radius:7px;background:linear-gradient(135deg,var(--accent),var(--accent2));display:inline-block}
  nav{display:flex;gap:4px;margin-left:auto}
  nav button{background:transparent;border:1px solid transparent;color:var(--muted);padding:8px 14px;border-radius:8px;cursor:pointer;font-size:14px}
  nav button.active{color:var(--text);background:var(--panel);border-color:var(--border)}
  main{max-width:1080px;margin:0 auto;padding:24px}
  .card{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:20px;margin-bottom:16px}
  h2{font-size:15px;margin:0 0 14px;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;font-weight:600}
  label{display:block;font-size:13px;color:var(--muted);margin:12px 0 6px}
  input,select{width:100%;background:var(--panel2);border:1px solid var(--border);color:var(--text);padding:10px 12px;border-radius:8px;font-size:14px}
  .row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}
  button.primary{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;border:none;padding:12px 20px;border-radius:9px;font-size:15px;font-weight:600;cursor:pointer;width:100%;margin-top:18px}
  button.primary:disabled{opacity:.5;cursor:not-allowed}
  .btn{background:var(--panel2);border:1px solid var(--border);color:var(--text);padding:7px 12px;border-radius:7px;cursor:pointer;font-size:13px}
  .btn:hover{border-color:var(--accent)}
  table{width:100%;border-collapse:collapse;font-size:14px}
  th,td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--border)}
  th{color:var(--muted);font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.4px}
  .badge{display:inline-block;padding:3px 9px;border-radius:20px;font-size:12px;font-weight:600}
  .b-queued{background:#2a3550;color:#9db4e6}
  .b-running{background:#2a2350;color:#b7a6ff}
  .b-completed{background:#12351f;color:#5fe08a}
  .b-failed{background:#3a1a1a;color:#ff8a8a}
  .b-cancelled{background:#3a2f1a;color:#e6c07a}
  .sev-pass{color:var(--ok)} .sev-low{color:#5aa9ff} .sev-medium{color:var(--warn)}
  .sev-high{color:#ff8a5c} .sev-critical{color:var(--bad)} .sev-ERROR{color:var(--muted)}
  .bar{height:8px;background:var(--panel2);border-radius:6px;overflow:hidden;margin-top:6px}
  .bar>div{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .4s}
  .muted{color:var(--muted);font-size:13px}
  .stages{display:flex;flex-direction:column;gap:6px;margin-top:10px}
  .stage{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted)}
  .stage .dot{width:10px;height:10px;border-radius:50%;background:var(--border)}
  .stage.done .dot{background:var(--ok)} .stage.active .dot{background:var(--accent);box-shadow:0 0 8px var(--accent)}
  .stage.done,.stage.active{color:var(--text)}
  .empty{color:var(--muted);text-align:center;padding:40px;font-size:14px}
  .warn{background:#3a2f1a;border:1px solid #6b5320;color:#e6c07a;padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:14px}
  .kv{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px dashed var(--border);font-size:14px}
  .kv span:first-child{color:var(--muted)}
  code{background:var(--panel2);padding:2px 6px;border-radius:5px;font-size:12px}
  .detail-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px}
  .pill{background:var(--chip);border:1px solid var(--border);border-radius:8px;padding:8px 10px;font-size:13px}
  .pill b{display:block;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.4px;margin-bottom:3px;font-weight:600}
  .scenario{border:1px solid var(--border);border-radius:10px;padding:14px;margin-bottom:10px;background:var(--panel2)}
  .scenario h4{margin:0 0 6px;font-size:14px}
  .conv{font-size:13px;line-height:1.5;margin-top:8px}
  .conv .role{color:var(--accent);font-weight:600}
  .hidden{display:none}
  .toast{position:fixed;bottom:20px;right:20px;background:var(--panel);border:1px solid var(--border);padding:12px 18px;border-radius:10px;font-size:14px;box-shadow:0 8px 30px rgba(0,0,0,.4);z-index:50}
</style>
</head>
<body>
<header>
  <span class="logo"></span>
  <h1>SimpleAudit Platform</h1>
  <nav>
    <button data-view="audits" class="active">Audits</button>
    <button data-view="new">New Audit</button>
    <button data-view="scenarios">Scenarios</button>
    <button data-view="compare">Compare</button>
  </nav>
</header>
<main>
  <!-- AUDITS / QUEUE -->
  <section id="view-audits">
    <div class="card">
      <h2>Audits</h2>
      <div id="audit-list"></div>
    </div>
  </section>

  <!-- NEW AUDIT WIZARD -->
  <section id="view-new" class="hidden">
    <div class="card">
      <h2>New Audit</h2>
      <label>Audit name</label>
      <input id="n-name" placeholder="Norwegian healthcare assistant – Sept release" />
      <div class="row">
        <div>
          <label>Scenario set &amp; version</label>
          <select id="n-set"></select>
          <div class="muted" id="n-set-info" style="margin-top:6px"></div>
        </div>
        <div>
          <label>Judge profile</label>
          <select id="n-judge">
            <option value="safety">Safety (Constitutional AI)</option>
            <option value="abstention">Abstention / refusal</option>
            <option value="helpfulness">Helpfulness (MT-Bench)</option>
            <option value="factuality">Factuality / hallucination</option>
            <option value="harm">Harm categorisation (HELM)</option>
          </select>
        </div>
      </div>
      <div class="row3">
        <div><label>Target model</label><select id="n-target"></select></div>
        <div><label>Auditor model</label><select id="n-auditor"></select></div>
        <div><label>Judge model</label><select id="n-judge-model"></select></div>
      </div>
      <label>Auditor turns per scenario</label>
      <select id="n-turns"><option>1</option><option selected>2</option><option>3</option></select>
      <button class="primary" id="n-start">Start Audit</button>
    </div>
  </section>

  <!-- SCENARIOS -->
  <section id="view-scenarios" class="hidden">
    <div class="card">
      <h2>Scenario Library</h2>
      <div id="set-list"></div>
    </div>
  </section>

  <!-- COMPARE -->
  <section id="view-compare" class="hidden">
    <div class="card">
      <h2>Compare Audits</h2>
      <p class="muted">Select two or more completed audits to compare side by side.</p>
      <div id="cmp-select"></div>
      <button class="btn" id="cmp-go" style="margin-top:14px">Compare selected</button>
    </div>
    <div class="card hidden" id="cmp-result"></div>
  </section>

  <!-- DETAIL -->
  <section id="view-detail" class="hidden">
    <div class="card">
      <button class="btn" onclick="show('audits')">← Back to audits</button>
      <div id="detail-body" style="margin-top:16px"></div>
    </div>
  </section>
</main>

<script>
const $ = s => document.querySelector(s);
const $$ = s => Array.from(document.querySelectorAll(s));
let MODELS=[], SETS=[];
let esMap={}; // run_id -> EventSource

function toast(msg){ const t=document.createElement('div'); t.className='toast'; t.textContent=msg; document.body.appendChild(t); setTimeout(()=>t.remove(),2600); }
async function api(path, opts){ const r=await fetch(path, opts); if(!r.ok) throw new Error((await r.json()).detail||r.statusText); return r.json(); }
const post=(p,b)=>api(p,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)});

function show(view){
  $$('#main > section, main > section').forEach(s=>s.classList.add('hidden'));
  $('#view-'+view).classList.remove('hidden');
  $$('#nav button, nav button').forEach(b=>b.classList.toggle('active', b.dataset.view===view));
  if(view==='audits') loadAudits();
  if(view==='scenarios') loadSets();
  if(view==='compare') loadCompareSelect();
}
$$('nav button').forEach(b=>b.onclick=()=>show(b.dataset.view));

// ---------- AUDITS ----------
async function loadAudits(){
  const runs = await api('/api/audits');
  const el=$('#audit-list');
  if(!runs.length){ el.innerHTML='<div class="empty">No audits yet. Create one from “New Audit”.</div>'; return; }
  el.innerHTML = '<table><thead><tr><th>Name</th><th>Status</th><th>Progress</th><th>Safe</th><th></th></tr></thead><tbody>'+
    runs.map(r=>{
      const m=r.summary_metrics||{};
      const pct = r.total_scenarios? Math.round(((r.completed_scenarios||0)/r.total_scenarios)*100):0;
      const prog = (r.status==='running')? `<div class="bar"><div style="width:${pct}%"></div></div><div class="muted">${r.completed_scenarios||0}/${r.total_scenarios}</div>` : '';
      const safe = m.safe_rate!=null? (m.safe_rate*100).toFixed(0)+'%' : '—';
      return `<tr>
        <td><a href="#" onclick="openDetail(${r.id});return false">${r.name}</a></td>
        <td><span class="badge b-${r.status}">${r.status}</span></td>
        <td>${prog || (r.status==='completed'?'✓ done':r.status)}</td>
        <td>${safe}</td>
        <td>
          ${r.status==='running'?`<button class="btn" onclick="cancelRun(${r.id})">Cancel</button>`:''}
          ${(r.status==='failed'||r.status==='cancelled')?`<button class="btn" onclick="retryRun(${r.id})">Retry</button>`:''}
        </td></tr>`;
    }).join('')+'</tbody></table>';
  // attach SSE to running runs
  runs.filter(r=>r.status==='running').forEach(r=>attachSSE(r.id));
}
function attachSSE(id){
  if(esMap[id]) return;
  const es=new EventSource(`/api/audits/${id}/events`);
  esMap[id]=es;
  es.onmessage=e=>{ try{ JSON.parse(e.data); }catch(_){} };
  es.onclose=()=>{ delete esMap[id]; loadAudits(); };
  es.onerror=()=>{ /* keepalive handles reconnect */ };
}
async function cancelRun(id){ if(confirm('Cancel this audit?')){ await post(`/api/audits/${id}/cancel`); loadAudits(); } }
async function retryRun(id){ const r=await post(`/api/audits/${id}/retry`); toast('Retried → run #'+r.id); loadAudits(); }

// ---------- NEW AUDIT ----------
async function loadNew(){
  MODELS = await api('/api/models');
  SETS = await api('/api/scenario-sets');
  const opt=m=>`<option value="${m.id}">${m.display_name}</option>`;
  ['#n-target','#n-auditor','#n-judge-model'].forEach(sel=>$(sel).innerHTML=MODELS.map(opt).join(''));
  // sets with their latest version
  let setOpts='';
  for(const s of SETS){
    const vers=await api(`/api/scenario-sets/${s.id}/versions`);
    const v=vers[0];
    if(v) setOpts+=`<option value="${v.id}" data-count="${v.scenario_count}" data-ver="${v.version}">${s.name} — v${v.version} (${v.scenario_count})</option>`;
  }
  $('#n-set').innerHTML=setOpts;
  const upd=()=>{ const o=$('#n-set').selectedOptions[0]; $('#n-set-info').textContent=o?`${o.dataset.count} scenarios · pinned to immutable v${o.dataset.ver}`:''; };
  $('#n-set').onchange=upd; upd();
}
$('#n-start').onclick=async()=>{
  const btn=$('#n-start'); btn.disabled=true;
  try{
    const r=await post('/api/audits',{
      name:$('#n-name').value||'Untitled audit',
      scenario_set_version_id:+$('#n-set').value,
      target_endpoint_id:+$('#n-target').value,
      auditor_endpoint_id:+$('#n-auditor').value,
      judge_endpoint_id:+$('#n-judge-model').value,
      judge_name:$('#n-judge').value,
      max_turns:+$('#n-turns').value,
    });
    toast('Audit #'+r.id+' queued');
    openDetail(r.id);
  }catch(e){ toast('Error: '+e.message); }
  btn.disabled=false;
};

// ---------- SCENARIOS ----------
async function loadSets(){
  SETS = await api('/api/scenario-sets');
  const el=$('#set-list');
  el.innerHTML = SETS.map(s=>`
    <div class="scenario">
      <h4>${s.name} <span class="muted">· latest v${s.latest_version} · ${s.scenario_count} scenarios</span></h4>
      <button class="btn" onclick="loadSetVersions(${s.id})">View versions &amp; scenarios</button>
      <div id="sv-${s.id}" style="margin-top:12px"></div>
    </div>`).join('');
}
async function loadSetVersions(setId){
  const vers=await api(`/api/scenario-sets/${setId}/versions`);
  const box=$('#sv-'+setId);
  box.innerHTML = vers.map(v=>`<div class="kv"><span>v${v.version} · ${v.created_at.slice(0,10)} · ${v.scenario_count} scenarios · ${v.content_hash}</span><a href="#" onclick="loadVersion(${v.id});return false">view</a></div>`).join('')
    + `<div id="ver-detail" style="margin-top:12px"></div>`;
}
async function loadVersion(vid){
  const v=await api(`/api/scenario-set-versions/${vid}`);
  $('#ver-detail').innerHTML = v.scenarios.map(s=>`
    <div class="scenario"><h4>${s.name}</h4><div class="muted">${s.description||''}</div></div>`).join('');
}

// ---------- COMPARE ----------
async function loadCompareSelect(){
  const runs=(await api('/api/audits')).filter(r=>r.status==='completed');
  $('#cmp-select').innerHTML = runs.length? runs.map(r=>`<label style="display:flex;gap:8px;align-items:center;margin:6px 0;color:var(--text)"><input type="checkbox" class="cmp-cb" value="${r.id}" style="width:auto"> ${r.name}</label>`).join('') : '<div class="empty">No completed audits to compare.</div>';
}
$('#cmp-go').onclick=async()=>{
  const ids=$$('.cmp-cb:checked').map(c=>+c.value);
  if(ids.length<2){ toast('Select at least 2 audits'); return; }
  const res=await post('/api/audits/compare',{run_ids:ids,only_identical_scenarios:false});
  renderCompare(res);
};
function renderCompare(res){
  const box=$('#cmp-result'); box.classList.remove('hidden');
  const cols=res.columns;
  let html = res.warning? `<div class="warn">⚠ ${res.warning}</div>`:'';
  html += '<table><thead><tr><th>Metric</th>'+cols.map(c=>`<th>${c.name}<br><span class="muted">${c.target||''}</span></th>`).join('')+'</tr></thead><tbody>';
  const rows=[
    ['Target', c=>c.target],['Auditor', c=>c.auditor],['Judge', c=>c.judge],
    ['Scenario version', c=>'v'+c.scenario_version],['Total', c=>c.total],
    ['Safe rate', c=>c.safe_rate!=null?(c.safe_rate*100).toFixed(1)+'%':'—'],
    ['Unsafe rate', c=>c.unsafe_rate!=null?(c.unsafe_rate*100).toFixed(1)+'%':'—'],
    ['pass', c=>c.pass],['low', c=>c.low],['medium', c=>c.medium],['high', c=>c.high],['critical', c=>c.critical],
  ];
  for(const [label,fn] of rows){
    html+=`<tr><td>${label}</td>`+cols.map(c=>`<td>${fn(c)}</td>`).join('')+'</tr>';
  }
  html+='</tbody></table>';
  box.innerHTML=html;
}

// ---------- DETAIL ----------
async function openDetail(id){
  show('detail');
  const r=await api(`/api/audits/${id}`);
  const m=r.summary_metrics||{};
  const sc=m.severity_counts||{};
  const stages=['loading','audit','persisting','completed'];
  const cur=r.current_stage||'queued';
  const stageHtml = r.status==='running'||r.status==='completed' ? `<div class="stages">`+
    stages.map(s=>`<div class="stage ${cur===s?'active':''} ${stages.indexOf(s)<stages.indexOf(cur)?'done':''}"><span class="dot"></span>${s}</div>`).join('')+`</div>`:'';
  $('#detail-body').innerHTML=`
    <h2 style="color:var(--text);font-size:20px;text-transform:none">${r.name} <span class="badge b-${r.status}">${r.status}</span></h2>
    ${stageHtml}
    <div class="row" style="margin-top:16px">
      <div>
        <h2>Configuration</h2>
        <div class="detail-grid">
          <div class="pill"><b>Target</b>${r.target_config_snapshot.display_name}</div>
          <div class="pill"><b>Auditor</b>${r.auditor_config_snapshot.display_name}</div>
          <div class="pill"><b>Judge</b>${r.judge_config_snapshot.display_name} · ${r.judge_config_snapshot.judge_name}</div>
          <div class="pill"><b>Scenario set</b>v${(await api(`/api/scenario-set-versions/${r.scenario_set_version_id}`)).version}</div>
          <div class="pill"><b>simpleaudit</b>${r.simpleaudit_version}</div>
          <div class="pill"><b>Turns</b>${r.judge_config_snapshot.max_turns}</div>
        </div>
        <div style="margin-top:12px">
          <a class="btn" href="/api/audits/${id}/manifest" target="_blank">Download reproducibility manifest</a>
        </div>
      </div>
      <div>
        <h2>Summary</h2>
        <div class="kv"><span>Total scenarios</span><span>${m.total??r.total_scenarios}</span></div>
        <div class="kv"><span>Safe rate</span><span>${m.safe_rate!=null?(m.safe_rate*100).toFixed(1)+'%':'—'}</span></div>
        <div class="kv"><span>Unsafe rate</span><span>${m.unsafe_rate!=null?(m.unsafe_rate*100).toFixed(1)+'%':'—'}</span></div>
        <div class="kv"><span>Severity</span><span>${Object.entries(sc).map(([k,v])=>`<span class="sev-${k}">${k}:${v}</span>`).join(' ')}</span></div>
        <div class="kv"><span>Tokens (T/A/J)</span><span>${m.target_tokens??0} / ${m.auditor_tokens??0} / ${m.judge_tokens??0}</span></div>
      </div>
    </div>
    <h2 style="margin-top:20px">Results</h2>
    <div id="results"></div>`;
  loadResults(id);
  if(r.status==='running') attachSSE(id);
}
async function loadResults(id){
  const rows=await api(`/api/audits/${id}/results`);
  const el=$('#results'); if(!el) return;
  if(!rows.length){ el.innerHTML='<div class="empty">No results yet — still running.</div>'; return; }
  el.innerHTML=rows.map(r=>{
    const conv=(r.conversation||[]).map(m=>`<div><span class="role">${m.role}:</span> ${escapeHtml(m.content||'')}</div>`).join('');
    return `<div class="scenario">
      <h4><span class="sev-${r.severity}">●</span> ${r.scenario_name} <span class="badge b-${r.status}">${r.severity}</span></h4>
      <div class="muted">${r.summary||''}</div>
      ${r.issues_found&&r.issues_found.length?`<div style="margin-top:6px;font-size:13px"><b>Issues:</b> ${r.issues_found.join('; ')}</div>`:''}
      <details style="margin-top:8px"><summary class="muted" style="cursor:pointer">Conversation</summary><div class="conv">${conv}</div></details>
    </div>`;
  }).join('');
}
function escapeHtml(s){ return (s||'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c])); }

// ---------- init ----------
(async function init(){
  show('audits');
  await loadNew();
})();
// refresh detail results while running
setInterval(()=>{ if(!$('#view-detail').classList.contains('hidden')){ const id=location.hash.match(/(\d+)/); } }, 4000);
</script>
</body>
</html>
